{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "start"
      ],
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "web-local",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "local",
        "next",
        "start",
        "-p",
        "3200"
      ],
      "port": 3200
    }
  ]
}
