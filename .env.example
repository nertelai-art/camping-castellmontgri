# Copia a .env.local i omple els valors. Mai valors reals en aquest fitxer.

# --- Supabase ---
# En local, els valors surten de `pnpm exec supabase start` (claus de demostració).
# Per al remot, crea un .env.preview amb els del projecte (Settings → API Keys).
# URL del projecte Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Clau publicable (anon/publishable). Pot arribar al navegador; la protecció és RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clau secreta (service role). NOMÉS servidor: scripts de seed i migració d'imatges.
SUPABASE_SECRET_KEY=

# --- Sentry ---
# DSN del projecte nertel/camping-castellmontgri. Buit = Sentry desactivat.
NEXT_PUBLIC_SENTRY_DSN=
# Només per pujar source maps al build de Vercel
SENTRY_AUTH_TOKEN=

# --- Revalidació de contingut ---
# Secret compartit entre l'admin i la ruta de revalidació
REVALIDATE_SECRET=
# On el seed avisa la web perquè buidi la caché (p. ex. http://localhost:3000/api/revalidate). Opcional.
REVALIDATE_URL=

# --- Només per a aquesta màquina, si cal (vegeu README · Problemes coneguts) ---
# SWC_NATIVE_BINDING_CACHE=
