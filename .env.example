# Copia a .env.local i omple els valors. Mai valors reals en aquest fitxer.

# --- Supabase (fase 1) ---
# URL del projecte Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Clau publicable (anon/publishable). Pot arribar al navegador; la protecció és RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clau secreta (service role). NOMÉS servidor: scripts de seed i migració d'imatges.
SUPABASE_SECRET_KEY=

# --- Sentry (fase 1) ---
NEXT_PUBLIC_SENTRY_DSN=
# Només per pujar source maps al build de Vercel
SENTRY_AUTH_TOKEN=

# --- Revalidació de contingut (fase 1) ---
# Secret compartit entre l'admin i la ruta de revalidació
REVALIDATE_SECRET=

# --- Només per a aquesta màquina, si cal (vegeu README · Problemes coneguts) ---
# SWC_NATIVE_BINDING_CACHE=
